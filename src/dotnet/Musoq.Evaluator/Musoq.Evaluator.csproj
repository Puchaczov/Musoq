<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>$(MusoqEvaluatorVersion)</Version>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBundledTargetAbstractions</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);IncludeBundledTargetAbstractionSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Musoq.Parser\Musoq.Parser.csproj" />
    <ProjectReference Include="..\Musoq.Plugins\Musoq.Plugins.csproj" />
    <ProjectReference Include="..\Musoq.Schema\Musoq.Schema.csproj" />
    <ProjectReference Include="..\Musoq.Targets.Abstractions\Musoq.Targets.Abstractions.csproj" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <BundledTargetAbstraction Include="$(MSBuildProjectDirectory)\..\Musoq.Targets.Abstractions\bin\$(Configuration)\$(TargetFramework)\Musoq.Targets.Abstractions.dll" />
    <BundledTargetAbstractionDocumentation Include="$(MSBuildProjectDirectory)\..\Musoq.Targets.Abstractions\bin\$(Configuration)\$(TargetFramework)\Musoq.Targets.Abstractions.xml" />
    <BundledTargetAbstractionSymbol Include="$(MSBuildProjectDirectory)\..\Musoq.Targets.Abstractions\bin\$(Configuration)\$(TargetFramework)\Musoq.Targets.Abstractions.pdb" />
  </ItemGroup>
  <Target Name="IncludeBundledTargetAbstractions">
    <Error Condition="!Exists('%(BundledTargetAbstraction.FullPath)')"
           Text="Expected bundled target abstraction '%(BundledTargetAbstraction.FullPath)' was not built." />
    <Error Condition="!Exists('%(BundledTargetAbstractionDocumentation.FullPath)')"
           Text="Expected bundled target abstraction documentation '%(BundledTargetAbstractionDocumentation.FullPath)' was not built." />
    <ItemGroup>
      <BuildOutputInPackage Include="@(BundledTargetAbstraction)" />
      <BuildOutputInPackage Include="@(BundledTargetAbstractionDocumentation)" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeBundledTargetAbstractionSymbols">
    <Error Condition="!Exists('%(BundledTargetAbstractionSymbol.FullPath)')"
           Text="Expected bundled target abstraction symbols '%(BundledTargetAbstractionSymbol.FullPath)' were not built." />
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(BundledTargetAbstractionSymbol)">
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>
