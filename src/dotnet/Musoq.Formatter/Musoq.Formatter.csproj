<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>$(MusoqFormatterVersion)</Version>
        <Description>Source-preserving formatting of complete raw Musoq scripts using only Musoq.Parser.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Musoq.Parser\Musoq.Parser.csproj" />
    </ItemGroup>
</Project>
