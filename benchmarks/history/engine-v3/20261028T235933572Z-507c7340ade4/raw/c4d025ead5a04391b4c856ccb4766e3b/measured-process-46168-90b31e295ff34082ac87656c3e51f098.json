  "sql": "with recursive walk as (select r.Id as Id\r\nfrom bench.rows() r\r\nwhere r.Id = 0\r\nunion all select e.Id\r\nfrom walk w\r\ninner join bench.rows() e on e.Id = w.Id + 1) select Id\r\nfrom walk\r\norder by Id"
