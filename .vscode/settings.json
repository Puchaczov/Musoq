{
    "chat.tools.terminal.autoApprove": {
        "git checkout": true,
        "git add": true,
        "ForEach-Object": true,
        "dotnet clean": true,
        "git stash": true
    },
    "dotnet.defaultSolution": "src/dotnet/Musoq.sln",
    "[csharp]": {
        "editor.defaultFormatter": "csharpier.csharpier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
    },
    "[xml]": {
        "editor.defaultFormatter": "csharpier.csharpier-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
    }
}
