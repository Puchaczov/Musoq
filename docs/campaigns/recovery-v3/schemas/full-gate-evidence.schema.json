{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full gate evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "scopeId",
    "runId",
    "repositoryIdentity",
    "testedPayloadSha256",
    "startedAt",
    "finishedAt",
    "commands",
    "expectedTargets",
    "results",
    "skipAllowlist",
    "outcome"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "scopeId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "repositoryIdentity": {
      "type": "object"
    },
    "testedPayloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "executable",
          "argv",
          "exitCode",
          "stdoutArtifact",
          "stderrArtifact"
        ],
        "properties": {
          "executable": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exitCode": {
            "type": "integer"
          },
          "stdoutArtifact": {
            "type": "object"
          },
          "stderrArtifact": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "expectedTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "targetId",
          "passed",
          "failed",
          "skipped",
          "total",
          "discovered",
          "aborted",
          "artifact"
        ],
        "properties": {
          "targetId": {
            "type": "string"
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "discovered": {
            "type": "integer",
            "minimum": 0
          },
          "aborted": {
            "type": "boolean"
          },
          "artifact": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "skipAllowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "testId",
          "reason"
        ],
        "properties": {
          "testId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "incomplete",
        "cancelled"
      ]
    }
  }
}
