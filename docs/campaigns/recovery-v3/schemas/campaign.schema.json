{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Musoq recovery campaign v3 ledger",
  "type": "object",
  "required": [
    "$schema",
    "formatVersion",
    "campaign",
    "activeLane",
    "lanes",
    "targetBindings",
    "productSnapshotReference",
    "priorCampaign",
    "sources",
    "authorityPolicy",
    "sourceBindings",
    "fullGate",
    "commitPolicy",
    "caseContract",
    "reviewPolicy",
    "artifactPaths",
    "budgetPolicy",
    "globalCompletion",
    "goalPrompt",
    "scopes"
  ],
  "properties": {
    "campaign": {
      "type": "object"
    },
    "targetBindings": {
      "type": "object"
    },
    "productSnapshotReference": {
      "type": "object"
    },
    "priorCampaign": {
      "type": "object"
    },
    "authorityPolicy": {
      "type": "object"
    },
    "fullGate": {
      "type": "object"
    },
    "commitPolicy": {
      "type": "object"
    },
    "caseContract": {
      "type": "object"
    },
    "reviewPolicy": {
      "type": "object"
    },
    "artifactPaths": {
      "type": "object"
    },
    "budgetPolicy": {
      "type": "object"
    },
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 3
    },
    "activeLane": {
      "enum": [
        "engine",
        "product",
        "empirical"
      ]
    },
    "lanes": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "sourceBindings": {
      "type": "array"
    },
    "globalCompletion": {
      "type": "string"
    },
    "goalPrompt": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "minItems": 82,
      "maxItems": 82,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "lane",
          "category",
          "kind",
          "title",
          "objective",
          "sources",
          "priorScopeIds",
          "risk",
          "obligations",
          "scopeAcceptance",
          "mustNotDo",
          "dependsOn",
          "limits",
          "state",
          "completed",
          "testsPassed",
          "progress",
          "completion",
          "blocker"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REC-[0-9]{3}$"
          },
          "order": {
            "type": "integer",
            "minimum": 84,
            "maximum": 165
          },
          "lane": {
            "enum": [
              "engine",
              "product",
              "empirical"
            ]
          },
          "category": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "sections",
                "selectorKind"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "selectorKind": {
                  "enum": [
                    "heading",
                    "json-pointer"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "priorScopeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "enum": [
              "standard",
              "broad"
            ]
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "requirement",
                "status",
                "evidenceIds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^REC-[0-9]{3}-O[0-9]{2}$"
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "pending",
                    "in_progress",
                    "evidenced",
                    "blocked"
                  ]
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "scopeAcceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "mustNotDo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "object"
          },
          "state": {
            "enum": [
              "pending",
              "in_progress",
              "blocked",
              "completed"
            ]
          },
          "completed": {
            "type": "boolean"
          },
          "testsPassed": {
            "type": "boolean"
          },
          "progress": {
            "type": "object"
          },
          "completion": {
            "type": "object",
            "required": [
              "completedAt",
              "validatedFromCommit",
              "testedPayloadSha256",
              "reportPath",
              "reportSha256",
              "fullGateEvidence",
              "reviewEvidence",
              "testCommands",
              "testSummary",
              "commitMessage",
              "notes"
            ],
            "properties": {
              "completedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "validatedFromCommit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "testedPayloadSha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reportPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reportSha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fullGateEvidence": {
                "type": "array"
              },
              "reviewEvidence": {
                "type": "array"
              },
              "testCommands": {
                "type": "array"
              },
              "testSummary": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commitMessage": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "blocker": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "completed": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "state": {
                  "const": "completed"
                },
                "testsPassed": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "properties": {
                "completed": {
                  "const": true
                },
                "testsPassed": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
