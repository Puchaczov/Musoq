  "productionFindings": [
    {
      "id": "REC-130-F01",
      "status": "resolved",
      "title": "Bounded nested interpretation did not rebase failure progress or position",
      "trigger": "SP-05, SP-10 and SP-11 failed after fixture calibration with parent BytesConsumed stuck at the substream start and diagnostics retaining bounded-slice-relative positions.",
      "rootCause": "InterpretNestedAt called InterpretAt on a length-bounded slice at offset zero, but its ParseException path neither transferred the child cursor progress to the parent nor translated the child Position back to the parent substrate.",
      "repair": "InterpretNestedAt now captures the parent cursor, transfers child BytesConsumed minus offset on failure, rebases the child error position with checked arithmetic, and preserves the qualified nested field path.",
      "evidenceIds": [
        "initial-focused-r6-trx",
        "focused-final-trx",
        "initial-adjacent-binary045-trx",
        "adjacent-binary045-trx",
        "full-gate",
        "report"
      ]
    }
  ],
