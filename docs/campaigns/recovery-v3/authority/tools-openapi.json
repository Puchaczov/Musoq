{
  "openapi": "3.0.1",
  "info": {
    "title": "Musoq CLI tool REST API",
    "version": "development",
    "description": "Supported read and execution endpoints exposed by the Musoq CLI service. Other service routes are internal and are not part of this contract."
  },
  "paths": {
    "/tools/health": {
      "get": {
        "operationId": "getToolApiHealth",
        "summary": "Read service health and version",
        "responses": {
          "200": {
            "description": "The service is available.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "version"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tools": {
      "get": {
        "operationId": "listTools",
        "summary": "List executable tools and their parameter contracts",
        "responses": {
          "200": {
            "description": "Available tools.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tools"
                  ],
                  "properties": {
                    "tools": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ToolInfo"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tools/{name}": {
      "get": {
        "operationId": "executeTool",
        "summary": "Execute one named tool",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$",
              "maxLength": 100
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "yaml",
                "raw",
                "interpreted_json",
                "interpreted_yaml",
                "reconstructed_json",
                "reconstructed_yaml"
              ]
            }
          },
          {
            "name": "raw",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "description": "Additional query parameters are defined by the selected tool and are returned by GET /tools.",
        "responses": {
          "200": {
            "description": "Tool output. With raw=false this is a JSON envelope; with raw=true the response uses the selected formatter content type."
          },
          "400": {
            "description": "A parameter or output format is invalid."
          },
          "404": {
            "description": "The named tool does not exist."
          },
          "500": {
            "description": "Tool preparation or query execution failed."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ToolInfo": {
        "type": "object",
        "required": [
          "name",
          "endpoint",
          "description",
          "defaultFormat",
          "parameters"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "defaultFormat": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "default": {},
                "description": {
                  "type": "string",
                  "nullable": true
                }
              }
            }
          }
        }
      }
    }
  }
}
