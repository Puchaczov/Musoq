{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musoq.dev/contracts/describe-response.v1.schema.json",
  "title": "Musoq describe response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "catalogVersion",
    "request",
    "resources",
    "diagnostics",
    "nextActions"
  ],
  "properties": {
    "formatVersion": {
      "const": "1"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "enum": [
            "bootstrap",
            "search",
            "resolve",
            "observe"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "targetFingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "trust"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "trust": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "kind",
        "title",
        "summary",
        "aliases",
        "keywords",
        "tags",
        "version",
        "sha256",
        "authority",
        "provenance",
        "requiresHost",
        "relatedUris"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^musoq://"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority": {
          "enum": [
            "normative",
            "operational",
            "observed"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "requiresHost": {
          "type": "boolean"
        },
        "relatedUris": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^musoq://"
          }
        },
        "content": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        },
        "additional": {
          "type": "object"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "helpUri": {
          "type": "string",
          "pattern": "^musoq://"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "argv"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uri": {
          "type": "string",
          "pattern": "^musoq://"
        }
      }
    }
  }
}
